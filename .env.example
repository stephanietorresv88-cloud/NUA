# Nombres de las variables de entorno que necesita NUA — SIN valores.
# Cada valor real se pega directo en el dashboard de Vercel (o en .env.local en tu
# computadora, que nunca se sube a GitHub). Nunca se pega un valor real aquí.

# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hotmart — enlaces de pago de cada plan (Producto -> Precios -> copiar link)
NEXT_PUBLIC_HOTMART_CHECKOUT_MENSUAL=
NEXT_PUBLIC_HOTMART_CHECKOUT_ANUAL=

# Hotmart — token del webhook (Herramientas -> Webhook -> pestaña Autenticación)
HOTMART_HOTTOK=

# Notificaciones push — "npx web-push generate-vapid-keys". La privada NUNCA va
# aquí ni en Vercel: solo en los Secrets de Supabase Edge Functions.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Protege el cron diario de avisos — cualquier cadena larga al azar
CRON_SECRET=
